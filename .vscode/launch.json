{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "VITEJS Iniciar App <Play> (web)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3004",
      "preLaunchTask": "build-task",
      "postDebugTask": "Terminate All Tasks",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "VITEJS Debuggear App (contra chrome)",
      "url": "http://localhost:3004",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Docker: Attach to Node",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "address": "localhost",
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "/app",
      "sourceMaps": true
    },
    {
      "type": "node",
      "runtimeExecutable": "vite",
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "args": [
        "--port",
        "3004",
        "--mode",
        "development"
      ],
      "request": "launch",
      "name": "Launch Development server",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}",
      "outFiles": [
        "${workspaceFolder}/**/*.js"
      ]
    },
  ]
}